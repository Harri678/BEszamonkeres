<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title></title>
</head>
<body>
    <a href="/filter">Filter</a>
    <a href="/new">New</a>
    <table>
        <thead>
            <tr>
                <th>Nev</th>
                <th>Kategoria</th>
                <th>Ar</th>
                <th>Raktarkeszlet</th>
            </tr>
        </thead>
        <tbody>
            <% products.forEach(product => { %>

                <% if(product.stock <= 0){ %> 
                    <tr style="color: red; font-weight: bold;">
                <% }else{ %> 
                    <tr>
                <% } %> 
                    <td><%= product.name %> </td>
                    <td><%= product.category %> </td>
                    <td><%= product.price %> </td>

                    <% if(product.stock < 5){ %> 
                        <td style="color: red; font-weight: bold;"><%= product.stock %> </td>
                    <% }else{ %> 
                        <td><%= product.stock %> </td>
                    <% } %> 
               </tr> 
            <%  }); %> 
        </tbody>
    </table>
</body>
</html>